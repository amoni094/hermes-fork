"""Performance metric calculators for the Denuto platform."""

from __future__ import annotations

import math
import statistics
from collections import deque
from dataclasses import dataclass
from datetime import datetime, timezone


@dataclass
class MetricResult:
    """Result of a metric computation."""

    value: float
    confidence: float  # 0.0 - 1.0
    sample_size: int
    trend: str  # "improving", "stable", "declining", "insufficient_data"


# ---------------------------------------------------------------------------
# Productivity Metrics
# ---------------------------------------------------------------------------


def compute_weighted_throughput(jobs: list[dict], period_days: int = 30) -> MetricResult:
    """Compute weighted throughput from completed jobs.

    Each job dict should have: agreement_type, issue_count, page_count, completed_at
    Weights: NDA=1.0, DPA=1.3, SaaS=1.5, MSA=2.0
    Issue multiplier: 0-5=1.0, 6-10=1.2, 11-20=1.5, 21+=2.0
    Page multiplier: 1-10=1.0, 11-30=1.2, 31-50=1.5, 51+=2.0
    """
    _ = period_days
    if not jobs:
        return MetricResult(value=0, confidence=0, sample_size=0, trend="insufficient_data")

    base_weights = {"nda": 1.0, "dpa": 1.3, "saas": 1.5, "msa": 2.0}

    total_weight = 0.0
    for job in jobs:
        base = base_weights.get(job.get("agreement_type", "").lower(), 1.0)

        issue_count = job.get("issue_count", 0)
        if issue_count > 20:
            issue_mult = 2.0
        elif issue_count > 10:
            issue_mult = 1.5
        elif issue_count > 5:
            issue_mult = 1.2
        else:
            issue_mult = 1.0

        page_count = job.get("page_count", 0)
        if page_count > 50:
            page_mult = 2.0
        elif page_count > 30:
            page_mult = 1.5
        elif page_count > 10:
            page_mult = 1.2
        else:
            page_mult = 1.0

        total_weight += base * issue_mult * page_mult

    confidence = min(1.0, len(jobs) / 10)  # Full confidence at 10+ jobs
    return MetricResult(
        value=total_weight,
        confidence=confidence,
        sample_size=len(jobs),
        trend="insufficient_data",
    )


def compute_cycle_time(jobs: list[dict]) -> MetricResult:
    """Compute cycle time stats from jobs with created_at and completed_at (as epoch ms)."""
    durations = []
    for job in jobs:
        created = job.get("created_at_ms", 0)
        completed = job.get("completed_at_ms", 0)
        if created and completed and completed > created:
            durations.append(completed - created)

    if len(durations) < 3:
        return MetricResult(
            value=0,
            confidence=0,
            sample_size=len(durations),
            trend="insufficient_data",
        )

    median_ms = statistics.median(durations)
    confidence = min(1.0, len(durations) / 10)
    return MetricResult(
        value=median_ms,
        confidence=confidence,
        sample_size=len(durations),
        trend="insufficient_data",
    )


def compute_first_touch_rate(jobs: list[dict]) -> MetricResult:
    """Percentage of jobs completed without rework. Each job has 'had_rework' boolean.

    Also supports 'had_escalation' boolean (False = first-touch success) for
    reviewer-focused job dicts.
    """
    if len(jobs) < 5:
        return MetricResult(
            value=0,
            confidence=0,
            sample_size=len(jobs),
            trend="insufficient_data",
        )

    # Support both had_rework (legacy) and had_escalation (reviewer) schemas.
    def _is_first_touch(j: dict) -> bool:
        if "had_escalation" in j:
            return not j["had_escalation"]
        return not j.get("had_rework", False)

    no_rework = sum(1 for j in jobs if _is_first_touch(j))
    rate = no_rework / len(jobs)
    confidence = min(1.0, len(jobs) / 10)
    return MetricResult(
        value=rate,
        confidence=confidence,
        sample_size=len(jobs),
        trend="insufficient_data",
    )


def compute_error_rate(total_issues: int, errors: int) -> MetricResult:
    """Error rate = errors / total_issues."""
    if total_issues < 10:
        return MetricResult(
            value=0,
            confidence=0,
            sample_size=total_issues,
            trend="insufficient_data",
        )
    rate = errors / total_issues
    confidence = min(1.0, total_issues / 20)
    return MetricResult(
        value=rate,
        confidence=confidence,
        sample_size=total_issues,
        trend="insufficient_data",
    )


def compute_consistency_score(weekly_scores: list[float]) -> MetricResult:
    """1 - coefficient_of_variation of weekly quality scores. Higher = more consistent."""
    if len(weekly_scores) < 4:
        return MetricResult(
            value=0,
            confidence=0,
            sample_size=len(weekly_scores),
            trend="insufficient_data",
        )

    mean_val = statistics.mean(weekly_scores)
    if mean_val == 0:
        return MetricResult(
            value=0,
            confidence=0,
            sample_size=len(weekly_scores),
            trend="insufficient_data",
        )

    std_dev = statistics.stdev(weekly_scores)
    cv = std_dev / mean_val
    score = max(0.0, 1.0 - cv)
    confidence = min(1.0, len(weekly_scores) / 8)
    return MetricResult(
        value=score,
        confidence=confidence,
        sample_size=len(weekly_scores),
        trend="insufficient_data",
    )


def compute_feature_utilization(features_used: set[str], all_features: dict[str, float]) -> MetricResult:
    """Weighted feature utilization. all_features maps feature_name -> weight."""
    if not all_features:
        return MetricResult(value=0, confidence=0, sample_size=0, trend="insufficient_data")

    total_weight = sum(all_features.values())
    used_weight = sum(w for f, w in all_features.items() if f in features_used)
    score = used_weight / total_weight if total_weight > 0 else 0
    return MetricResult(
        value=score,
        confidence=min(1.0, len(features_used) / 3),
        sample_size=len(features_used),
        trend="insufficient_data",
    )


def compute_skill_velocity(weekly_skill_scores: list[float]) -> MetricResult:
    """Linear regression slope of weekly skill scores, normalized by mean."""
    if len(weekly_skill_scores) < 6:
        return MetricResult(
            value=0,
            confidence=0,
            sample_size=len(weekly_skill_scores),
            trend="insufficient_data",
        )

    n = len(weekly_skill_scores)
    x = list(range(n))
    x_mean = statistics.mean(x)
    y_mean = statistics.mean(weekly_skill_scores)

    if y_mean == 0:
        return MetricResult(value=0, confidence=0, sample_size=n, trend="insufficient_data")

    numerator = sum((x[i] - x_mean) * (weekly_skill_scores[i] - y_mean) for i in range(n))
    denominator = sum((x[i] - x_mean) ** 2 for i in range(n))

    if denominator == 0:
        return MetricResult(value=0, confidence=0, sample_size=n, trend="stable")

    slope = numerator / denominator
    normalized_velocity = slope / y_mean

    if normalized_velocity > 0.02:
        trend = "improving"
    elif normalized_velocity < -0.02:
        trend = "declining"
    else:
        trend = "stable"

    confidence = min(1.0, n / 12)
    return MetricResult(
        value=normalized_velocity,
        confidence=confidence,
        sample_size=n,
        trend=trend,
    )


def compute_active_days_ratio(active_days: int, business_days: int) -> MetricResult:
    """Ratio of active days to business days."""
    if business_days == 0:
        return MetricResult(value=0, confidence=0, sample_size=0, trend="insufficient_data")
    ratio = active_days / business_days
    confidence = min(1.0, business_days / 10)
    return MetricResult(
        value=ratio,
        confidence=confidence,
        sample_size=business_days,
        trend="insufficient_data",
    )


def compute_active_days_ratio_from_events(events: list[dict], period_days: int = 30) -> MetricResult:
    """Count distinct days with events in the last *period_days*.

    Each event must have a ``ts_ms`` key (Unix epoch milliseconds).
    Returns MetricResult with value = distinct_active_days / period_days.
    """
    if not events:
        return MetricResult(value=0.0, confidence=0.0, sample_size=0, trend="insufficient_data")

    now_ms = datetime.now(tz=timezone.utc).timestamp() * 1000
    cutoff_ms = now_ms - period_days * 86_400_000

    active_date_strings: set[str] = set()
    for ev in events:
        ts = ev.get("ts_ms", 0)
        if ts >= cutoff_ms:
            dt = datetime.fromtimestamp(ts / 1000, tz=timezone.utc)
            active_date_strings.add(dt.strftime("%Y-%m-%d"))

    distinct_days = len(active_date_strings)
    ratio = distinct_days / period_days if period_days > 0 else 0.0
    confidence = min(1.0, distinct_days / 5)
    return MetricResult(
        value=ratio,
        confidence=confidence,
        sample_size=distinct_days,
        trend="insufficient_data",
    )


# ---------------------------------------------------------------------------
# Trend Detection
# ---------------------------------------------------------------------------


def detect_trend(
    recent_values: list[float],
    baseline_values: list[float],
    threshold: float = 0.15,
) -> str:
    """Compare recent vs baseline values to detect trend direction.

    Returns: 'improving', 'declining', 'stable', or 'insufficient_data'
    """
    if len(recent_values) < 3 or len(baseline_values) < 3:
        return "insufficient_data"

    recent_mean = statistics.mean(recent_values)
    baseline_mean = statistics.mean(baseline_values)

    if baseline_mean == 0:
        return "insufficient_data"

    change = (recent_mean - baseline_mean) / abs(baseline_mean)

    if change > threshold:
        return "improving"
    elif change < -threshold:
        return "declining"
    return "stable"


# ---------------------------------------------------------------------------
# Temporal Weighting
# ---------------------------------------------------------------------------


def temporal_weight(age_days: float, half_life_days: float = 7.0) -> float:
    """Compute temporal decay weight using exponential half-life decay.

    weight = 2^(-age_days / half_life_days)

    This is equivalent to exp(-ln(2)/half_life * age) and is the standard
    half-life formulation from radioactive decay / exponential smoothing.
    Returns 1.0 for non-positive half_life_days (no decay).
    """
    if half_life_days <= 0:
        return 1.0
    return 2.0 ** (-age_days / half_life_days)


# ---------------------------------------------------------------------------
# Anti-Gaming Detection
# ---------------------------------------------------------------------------


@dataclass
class GamingFlag:
    flag_type: str
    description: str
    confidence: float


def detect_gaming(
    throughput_percentile: float,
    complexity_percentile: float,
    acceptance_rate: float,
    avg_review_seconds: float,
    idle_session_ratio: float,
) -> list[GamingFlag]:
    """Detect potential metric gaming patterns."""
    flags: list[GamingFlag] = []

    if throughput_percentile > 0.90 and complexity_percentile < 0.20:
        flags.append(
            GamingFlag(
                flag_type="volume_inflation",
                description="High throughput with very low complexity suggests cherry-picking",
                confidence=0.7,
            )
        )

    if acceptance_rate > 0.95 and avg_review_seconds < 5:
        flags.append(
            GamingFlag(
                flag_type="quality_manipulation",
                description="Near-total acceptance with very fast review times suggests rubber-stamping",
                confidence=0.8,
            )
        )

    if idle_session_ratio > 0.30:
        flags.append(
            GamingFlag(
                flag_type="engagement_inflation",
                description="High proportion of idle sessions suggests gaming active time",
                confidence=0.6,
            )
        )

    return flags


# ---------------------------------------------------------------------------
# Theory-Grounded Metrics (Theory citations in each docstring)
# ---------------------------------------------------------------------------


def bayesian_confidence_interval(
    successes: int, trials: int, credible_mass: float = 0.9
) -> tuple[float, float]:
    """Compute a Bayesian credible interval for a binomial success rate.

    Theory: Jaynes, *Probability Theory: The Logic of Science* (2003).
    Uses a Beta(successes+1, failures+1) posterior (Laplace's rule of succession),
    which is the Bayesian conjugate prior for binomial likelihoods.  The posterior
    mean and variance are approximated with a Normal distribution for tractability
    (no scipy dependency).

    Approximation:
        mean = (s+1) / (n+2)
        var  = mean * (1-mean) / (n+3)
        z    = 1.645  for 90% credible mass

    Parameters
    ----------
    successes:
        Number of observed successes.
    trials:
        Total number of trials (>= successes).
    credible_mass:
        Desired credible interval width (default 0.9 → 90%).

    Returns
    -------
    (lower, upper) both clamped to [0, 1].
    """
    if trials < 0 or successes < 0 or successes > trials:
        return (0.0, 1.0)

    mean = (successes + 1) / (trials + 2)
    var = mean * (1 - mean) / (trials + 3)
    std = math.sqrt(var)

    # z-score lookup: only 90% is requested in the spec; extend if needed.
    z_map = {0.9: 1.645, 0.95: 1.960, 0.99: 2.576}
    z = z_map.get(credible_mass, 1.645)

    lower = max(0.0, mean - z * std)
    upper = min(1.0, mean + z * std)
    return (lower, upper)


def mann_kendall_trend(values: list[float]) -> tuple[str, float]:
    """Non-parametric Mann-Kendall trend test on a time series.

    Theory: Grimmett & Stirzaker, *Probability and Random Processes* (2001),
    ch. 9 (rank-based statistics).  The Mann-Kendall statistic τ (Kendall's tau)
    counts concordant minus discordant pairs normalised by n*(n-1)/2.

    Classification thresholds:
        τ >  0.2 → 'increasing'
        τ < -0.2 → 'decreasing'
        else     → 'stable'

    Parameters
    ----------
    values:
        Ordered time-series observations (oldest first).

    Returns
    -------
    (label, tau)  where label ∈ {'increasing', 'decreasing', 'stable'}.
    """
    n = len(values)
    if n < 2:
        return ("stable", 0.0)

    concordant = 0
    discordant = 0
    for i in range(n - 1):
        for j in range(i + 1, n):
            diff = values[j] - values[i]
            if diff > 0:
                concordant += 1
            elif diff < 0:
                discordant += 1

    denominator = n * (n - 1) / 2
    tau = (concordant - discordant) / denominator if denominator > 0 else 0.0

    if tau > 0.2:
        label = "increasing"
    elif tau < -0.2:
        label = "decreasing"
    else:
        label = "stable"

    return (label, tau)


def sprt_regression_test(
    observations: list[float],
    h0_mean: float,
    h1_mean: float,
    alpha: float = 0.05,
    beta: float = 0.10,
) -> str:
    """Sequential Probability Ratio Test (SPRT) for early regression detection.

    Theory: Wald, *Sequential Analysis* (1947).  The SPRT is the most powerful
    sequential test for distinguishing two simple hypotheses, offering a
    logarithmic reduction in expected sample size compared to fixed-n tests.

    H0: observations ~ N(h0_mean, σ²)
    H1: observations ~ N(h1_mean, σ²)
    σ  = max(|h1_mean - h0_mean| / 2, 0.01)   (shared std, conservative)

    Thresholds (Wald 1947, eq. 3.1):
        Accept H1 if cumulative LLR > log((1-β)/α)
        Accept H0 if cumulative LLR < log(β/(1-α))
        Otherwise continue collecting data.

    Parameters
    ----------
    observations:
        Sequential observations (in order of arrival).
    h0_mean:
        Null hypothesis mean.
    h1_mean:
        Alternative hypothesis mean (regression level).
    alpha:
        Type-I error bound (false positive rate, default 0.05).
    beta:
        Type-II error bound (false negative rate, default 0.10).

    Returns
    -------
    'accept_h1' | 'accept_h0' | 'continue'
    """
    if not observations:
        return "continue"

    sigma = max(abs(h0_mean - h1_mean) / 2.0, 0.01)

    upper = math.log((1 - beta) / alpha)
    lower = math.log(beta / (1 - alpha))

    llr = 0.0
    for x in observations:
        # log-likelihood ratio for one Gaussian observation
        llr += (
            -(x - h1_mean) ** 2 / (2 * sigma ** 2)
            + (x - h0_mean) ** 2 / (2 * sigma ** 2)
        )
        if llr >= upper:
            return "accept_h1"
        if llr <= lower:
            return "accept_h0"

    return "continue"


def entropy_consistency(weekly_scores: list[float], n_bins: int = 10) -> float:
    """Entropy-based consistency score for a distribution of weekly scores.

    Theory: Cover & Thomas, *Elements of Information Theory* (2006), ch. 2.
    A perfectly consistent reviewer concentrates mass in one bin (H → 0),
    yielding a score of 1.0.  A maximally spread reviewer has uniform mass
    (H = log₂(n_bins)), yielding a score of 0.0.

    Score = 1 - H / log₂(n_bins)

    Scores are binned into *n_bins* equal-width bins over [0, 1].

    Parameters
    ----------
    weekly_scores:
        Quality scores in [0, 1], one per week.
    n_bins:
        Number of equal-width histogram bins (default 10).

    Returns
    -------
    Consistency score in [0, 1].  Returns 1.0 for an empty list or
    degenerate n_bins ≤ 1.
    """
    if not weekly_scores or n_bins <= 1:
        return 1.0

    counts = [0] * n_bins
    for score in weekly_scores:
        idx = min(int(score * n_bins), n_bins - 1)
        counts[idx] += 1

    total = len(weekly_scores)
    h = 0.0
    for c in counts:
        if c > 0:
            p = c / total
            h -= p * math.log2(p)

    max_entropy = math.log2(n_bins)
    if max_entropy == 0:
        return 1.0

    return 1.0 - h / max_entropy


# ---------------------------------------------------------------------------
# Additional helper functions required by aggregation pipeline
# ---------------------------------------------------------------------------


def detect_trend_single(values: list[float]) -> str:
    """Single-series Mann-Kendall trend label.

    Wraps :func:`mann_kendall_trend` and returns the label only.
    Maps 'increasing'/'decreasing' to 'improving'/'declining' to align
    with the MetricResult.trend vocabulary used elsewhere in the platform.
    """
    label, _ = mann_kendall_trend(values)
    mapping = {"increasing": "improving", "decreasing": "declining", "stable": "stable"}
    return mapping.get(label, label)


# ---------------------------------------------------------------------------
# Event-stream Gaming Detection (Sweep 12, CDH patterns)
# ---------------------------------------------------------------------------


@dataclass
class EventGamingFlag:
    """Gaming flag raised by the event-stream detector.

    Attributes
    ----------
    is_suspicious:
        True when a gaming pattern was detected.
    reason:
        Human-readable description of the pattern.
    count:
        The event/repeat count that triggered the flag.
    """

    is_suspicious: bool
    reason: str
    count: int


def detect_gaming_events(
    events: list[dict], window_hours: int = 24
) -> EventGamingFlag:
    """Detect reviewer metric-gaming patterns from an event stream.

    Uses an O(n) deque-based sliding window to find burst submissions and
    duplicate-content patterns as described in Sweep 12 CDH (Correlated
    Duplicate Hash) analysis.

    Flags raised:
    1. **Burst**: > 5 events within any *window_hours* rolling window.
    2. **Duplicate content**: an event's ``content_hash`` appears > 3 times
       within the same window (identical analyses submitted in bursts).

    Theory: Wald, *Sequential Analysis* (1947) — sequential anomaly detection
    with configurable thresholds.

    Parameters
    ----------
    events:
        List of event dicts, each with at least ``ts_ms`` (epoch ms) and
        optionally ``content_hash`` (str).
    window_hours:
        Rolling window size in hours (default 24).

    Returns
    -------
    :class:`EventGamingFlag`
    """
    if not events:
        return EventGamingFlag(is_suspicious=False, reason="", count=0)

    window_ms = window_hours * 3_600_000

    # Sort by timestamp ascending for sliding-window correctness.
    sorted_events = sorted(events, key=lambda e: e.get("ts_ms", 0))

    # --- Pass 1: burst detection (sliding window deque) ---
    dq: deque[int] = deque()
    max_burst = 0
    for ev in sorted_events:
        ts = ev.get("ts_ms", 0)
        dq.append(ts)
        # Evict events outside the window
        while dq and ts - dq[0] > window_ms:
            dq.popleft()
        if len(dq) > max_burst:
            max_burst = len(dq)

    if max_burst > 5:
        return EventGamingFlag(
            is_suspicious=True,
            reason=f"Burst of {max_burst} events detected within {window_hours}h window",
            count=max_burst,
        )

    # --- Pass 2: content-hash duplicate detection within window ---
    hash_window: deque[tuple[int, str]] = deque()  # (ts_ms, content_hash)
    hash_counts: dict[str, int] = {}

    for ev in sorted_events:
        ts = ev.get("ts_ms", 0)
        content_hash = ev.get("content_hash", "")
        if not content_hash:
            continue

        hash_window.append((ts, content_hash))
        hash_counts[content_hash] = hash_counts.get(content_hash, 0) + 1

        # Evict old entries from window
        while hash_window and ts - hash_window[0][0] > window_ms:
            old_ts, old_hash = hash_window.popleft()
            _ = old_ts
            if old_hash in hash_counts:
                hash_counts[old_hash] -= 1
                if hash_counts[old_hash] <= 0:
                    del hash_counts[old_hash]

        max_repeats = max(hash_counts.values(), default=0)
        if max_repeats > 3:
            worst_hash = max(hash_counts, key=lambda h: hash_counts[h])
            return EventGamingFlag(
                is_suspicious=True,
                reason=(
                    f"Content hash '{worst_hash}' submitted {max_repeats} times "
                    f"within {window_hours}h window (CDH pattern)"
                ),
                count=max_repeats,
            )

    return EventGamingFlag(is_suspicious=False, reason="", count=0)

