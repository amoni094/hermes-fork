"""
AIMD (Additive Increase/Multiplicative Decrease) concurrency controller.
Migrated from worker.js to Python.

Dynamically adjusts concurrency limits based on error and throttle rates.
Extended in Phase 27 with per-node, per-provider controllers and backpressure.
"""

from __future__ import annotations

import enum
import logging
import math
import threading
import time
from contextlib import contextmanager

logger = logging.getLogger(__name__)


# ---------------------------------------------------------------------------
# NodePriority enum
# ---------------------------------------------------------------------------


class NodePriority(enum.IntEnum):
    """Priority levels for pipeline nodes. Higher = more important."""

    LOW = 0
    MEDIUM = 1
    HIGH = 2


# Default budgets per node (initial concurrency limit)
_DEFAULT_BUDGETS: dict[str, int] = {
    "extractor": 8,
    "compiler": 4,
    "profiler": 2,
    "structural": 2,
    "llm_checks": 2,
}

# Default priorities per node
_NODE_PRIORITIES: dict[str, NodePriority] = {
    "extractor": NodePriority.HIGH,
    "compiler": NodePriority.MEDIUM,
    "profiler": NodePriority.MEDIUM,
    "structural": NodePriority.LOW,
    "llm_checks": NodePriority.LOW,
}

# Default budget for unknown nodes
_DEFAULT_BUDGET = 2
_DEFAULT_PRIORITY = NodePriority.MEDIUM


def _coerce_status_code(value: object) -> int:
    """Best-effort integer coercion for HTTP status values."""
    if isinstance(value, bool) or value is None:
        return 0
    if isinstance(value, int):
        return value
    if isinstance(value, str):
        value = value.strip()
        if value.isdigit():
            return int(value)
    return 0


def _extract_error_status_code(err: Exception) -> int:
    """Support SDK errors that expose status on either the exception or response.

    OpenAI SDK errors may attach an httpx ``Response`` object at ``err.response``,
    which does not implement ``dict.get``. Botocore-style errors instead expose a
    mapping with ``ResponseMetadata``. Handle both shapes safely.
    """
    for attr in ("status_code", "status"):
        code = _coerce_status_code(getattr(err, attr, None))
        if code:
            return code

    response = getattr(err, "response", None)
    if response is None:
        return 0

    if isinstance(response, dict):
        metadata = response.get("ResponseMetadata") or {}
        return _coerce_status_code(
            metadata.get("HTTPStatusCode") or response.get("status_code") or response.get("status")
        )

    for attr in ("status_code", "status"):
        code = _coerce_status_code(getattr(response, attr, None))
        if code:
            return code

    metadata = getattr(response, "ResponseMetadata", None) or getattr(response, "response_metadata", None)
    if isinstance(metadata, dict):
        return _coerce_status_code(metadata.get("HTTPStatusCode"))

    return 0


# ---------------------------------------------------------------------------
# ConcurrencyController (extended)
# ---------------------------------------------------------------------------


class ConcurrencyController:
    """Thread-safe adaptive concurrency controller with priority and backpressure."""

    def __init__(
        self,
        name: str,
        initial: int,
        min_limit: int,
        max_limit: int,
        priority: int = NodePriority.MEDIUM,
        registry: ControllerRegistry | None = None,
        provider: str = "",
    ):
        self.name = name
        self.limit = initial
        self.min_limit = min_limit
        self.max_limit = max_limit

        self._initial = initial
        self._priority = priority
        self._registry = registry
        self._provider = provider

        self._running = 0
        self._window: list[dict] = []
        self._window_size = 20
        self._ops = 0

        # Strogatz (Dynamical Systems) + Astrom-Murray (Feedback Control):
        # Track limit history to detect convergence to a fixed point.
        self._limit_history: list[float] = []

        self._cond = threading.Condition()

    def acquire(self, timeout: float = 30.0) -> None:
        """Acquire a slot, blocking if the current limit is reached.

        If this controller has LOW priority and its provider's health is
        degraded (ratio < 0.5), the acquire blocks until health recovers
        or the timeout expires.

        Args:
            timeout: Maximum seconds to wait. Raises TimeoutError on expiry.
        """
        deadline = time.monotonic() + timeout

        # --- Backpressure check for LOW priority nodes ---
        if self._priority <= NodePriority.LOW and self._registry and self._provider:
            while True:
                remaining = deadline - time.monotonic()
                if remaining <= 0:
                    raise TimeoutError(
                        f"[BACKPRESSURE][{self._provider}] {self.name} timed out "
                        f"waiting for provider health recovery (timeout={timeout}s)"
                    )
                health = self._registry.get_provider_health(self._provider)
                if health["ratio"] >= 0.5:
                    break
                logger.info(
                    "[BACKPRESSURE][%s] activated: delaying %s (ratio=%.2f)",
                    self._provider,
                    self.name,
                    health["ratio"],
                )
                # Poll every 0.05s (short for tests, low overhead in production)
                time.sleep(min(0.05, remaining))

        # --- Standard slot acquisition with timeout ---
        with self._cond:
            while self._running >= self.limit:
                remaining = deadline - time.monotonic()
                if remaining <= 0:
                    raise TimeoutError(
                        f"[{self.name}] acquire timed out after {timeout}s "
                        f"(running={self._running}, limit={self.limit})"
                    )
                self._cond.wait(timeout=min(remaining, 0.1))
            self._running += 1

    def release(self, duration_ms: float = 0.0, error: bool = False, throttled: bool = False) -> None:
        """Release a slot and update the sliding window of performance data."""
        with self._cond:
            self._window.append({"durationMs": duration_ms, "error": error, "throttled": throttled})
            if len(self._window) > self._window_size:
                self._window.pop(0)

            self._running -= 1
            self._ops += 1

            if self._ops % 5 == 0:
                self._adjust()

            self._cond.notify_all()

    def _adjust(self) -> None:
        """Evaluate the window and adjust the concurrency limit."""
        if len(self._window) < 5:
            return

        throttles = sum(1 for s in self._window if s["throttled"])
        errors = sum(1 for s in self._window if s["error"])
        prev = self.limit

        if throttles >= 2:
            # Aggressive decrease on rate limiting
            self.limit = max(self.min_limit, self.limit // 2)
        elif errors >= 3:
            # Moderate decrease on general errors
            self.limit = max(self.min_limit, int(self.limit * 0.7))
        elif errors == 0 and throttles == 0 and len(self._window) >= self._window_size * 0.75:
            # Additive increase when stable
            self.limit = min(self.max_limit, self.limit + 1)

        if self.limit != prev:
            lats = sorted([s["durationMs"] for s in self._window])
            p95 = lats[int(len(lats) * 0.95)] if lats else 0
            logger.info(
                "[ADAPTIVE][%s] %d -> %d (throttle=%d err=%d/%d p95=%dms)",
                self.name,
                prev,
                self.limit,
                throttles,
                errors,
                len(self._window),
                int(p95),
            )

    def is_near_fixed_point(self, tolerance: float = 0.05) -> bool:
        """Detect convergence to a dynamical fixed point.

        Theory: Strogatz (Nonlinear Dynamics and Chaos) and Astrom-Murray
        (Feedback Systems) predict that a stable AIMD system converges to a
        fixed point where additive increases and multiplicative decreases
        balance. This method detects that convergence by checking whether
        the last three limit values are within *tolerance* of each other.

        Args:
            tolerance: Maximum relative deviation between consecutive values
                       to be considered near a fixed point (default 0.05 = 5%).

        Returns:
            True if the controller's limit appears to have stabilised.
        """
        if len(self._limit_history) < 3:
            return False
        last3 = self._limit_history[-3:]
        for a, b in zip(last3, last3[1:]):
            if abs(a - b) / max(a, 1) >= tolerance:
                return False
        return True

    def update_with_latency(
        self,
        observed_ms: float,
        target_ms: float,
        kp: float = 0.1,
    ) -> None:
        """Proportional-integral latency-driven limit update.

        Theory: Astrom-Murray (Feedback Systems) proportional control law:
          u(t) = kp * e(t)
        where e(t) = target - observed. When observed < target (positive
        error) we have spare capacity and increase the limit (additive).
        When observed > target (negative error) we reduce the limit
        (multiplicative), matching the AIMD decrease axiom.

        The updated limit is recorded in _limit_history (max 5 entries) for
        fixed-point detection via is_near_fixed_point().

        Args:
            observed_ms: Measured end-to-end latency in milliseconds.
            target_ms:   SLO latency target in milliseconds.
            kp:          Proportional gain (default 0.1).
        """
        error = target_ms - observed_ms
        fraction = kp * abs(error) / max(target_ms, 1.0)
        prev = self.limit
        if error > 0:
            # Additive increase toward max_limit
            self.limit = min(self.max_limit, self.limit + fraction * (self.max_limit - self.limit))
        elif error < 0:
            # Multiplicative decrease toward min_limit
            self.limit = max(self.min_limit, self.limit - fraction * (self.limit - self.min_limit))
        # Clamp to [min_limit, max_limit]
        self.limit = max(self.min_limit, min(self.max_limit, self.limit))
        # Record in history (max 5 entries)
        self._limit_history.append(self.limit)
        if len(self._limit_history) > 5:
            self._limit_history.pop(0)
        if self.limit != prev:
            logger.debug(
                "[LATENCY][%s] limit %.2f -> %.2f (observed=%.1fms target=%.1fms)",
                self.name,
                prev,
                self.limit,
                observed_ms,
                target_ms,
            )

    @contextmanager
    def control(self):
        """Context manager for using the controller."""
        self.acquire()
        start = time.monotonic()
        try:
            yield
            self.release(duration_ms=(time.monotonic() - start) * 1000)
        except Exception as err:
            # Detect throttles (common HTTP status codes for quotas/rate limits)
            # Or text matches from OpenAI/Anthropic
            err_msg = str(err).lower()
            throttled = False

            # Check for botocore/SDK specific exceptions
            status_code = _extract_error_status_code(err)
            if status_code in (429, 503):
                throttled = True

            if "429" in err_msg or "rate_limit" in err_msg or "throttl" in err_msg or "insufficient_quota" in err_msg:
                throttled = True

            self.release(duration_ms=(time.monotonic() - start) * 1000, error=True, throttled=throttled)
            raise


def channel_capacity_estimate(success_rate: float, n_parallel: int) -> float:
    """Estimate effective throughput capacity using Shannon's channel capacity formula.

    Theory: Shannon (1948) 'A Mathematical Theory of Communication' defines
    channel capacity as C = B * log2(1 + SNR) where SNR is the signal-to-noise
    ratio. Here we model each parallel request slot as an independent binary
    channel where 'signal' is a successful request and 'noise' is a failed one.
    The aggregate capacity scales linearly with parallelism.

    Args:
        success_rate: Fraction of requests that succeed (0.0 – 1.0).
        n_parallel:   Number of parallel request slots (concurrency limit).

    Returns:
        Estimated channel capacity in 'successful requests per slot-unit'.
        Returns 0.0 when success_rate <= 0; n_parallel when success_rate >= 1.
    """
    if success_rate <= 0:
        return 0.0
    if success_rate >= 1:
        return float(n_parallel)
    snr = success_rate / max(1.0 - success_rate, 1e-9)
    return n_parallel * math.log2(1.0 + snr)


# ---------------------------------------------------------------------------
# ControllerRegistry
# ---------------------------------------------------------------------------


class ControllerRegistry:
    """Registry mapping (provider, node) pairs to independent ConcurrencyController instances.

    Each pipeline node gets its own AIMD controller per provider, so throttling
    OpenAI's extractor does not affect Anthropic's extractor or OpenAI's compiler.
    """

    def __init__(self):
        self._controllers: dict[str, dict[str, ConcurrencyController]] = {}
        self._lock = threading.Lock()
        self._budgets = self._load_budgets()

    @staticmethod
    def _load_budgets() -> dict[str, int]:
        """Load per-node budgets from config, falling back to defaults."""
        budgets = dict(_DEFAULT_BUDGETS)
        try:
            from src.config import get_config

            config = get_config()
            budget_attrs = {
                "extractor": "concurrency_extractor",
                "compiler": "concurrency_compiler",
                "profiler": "concurrency_profiler",
                "structural": "concurrency_structural",
                "llm_checks": "concurrency_llm_checks",
            }
            for node, attr in budget_attrs.items():
                val = getattr(config, attr, None)
                if val is not None:
                    budgets[node] = val
        except Exception:
            logger.warning("Could not load config for concurrency budgets; using defaults")
        return budgets

    def get(self, provider: str, node: str) -> ConcurrencyController:
        """Get or create a ConcurrencyController for the given (provider, node) pair.

        Thread-safe. Returns the same instance for repeated calls with the
        same arguments.
        """
        with self._lock:
            if provider not in self._controllers:
                self._controllers[provider] = {}

            provider_map = self._controllers[provider]
            if node not in provider_map:
                budget = self._budgets.get(node, _DEFAULT_BUDGET)
                priority = _NODE_PRIORITIES.get(node, _DEFAULT_PRIORITY)
                ctrl = ConcurrencyController(
                    name=f"{provider}:{node}",
                    initial=budget,
                    min_limit=1,
                    max_limit=budget * 3,
                    priority=priority,
                    registry=self,
                    provider=provider,
                )
                provider_map[node] = ctrl
                logger.debug(
                    "Created controller %s:%s (budget=%d, priority=%s)",
                    provider,
                    node,
                    budget,
                    NodePriority(priority).name,
                )

            return provider_map[node]

    def get_provider_health(self, provider: str) -> dict:
        """Calculate aggregate health for a provider across all its nodes.

        Returns:
            dict with keys: total_limit, total_initial, ratio
            ratio = current total limit / initial total limit (1.0 = healthy)
        """
        with self._lock:
            provider_map = self._controllers.get(provider, {})
            if not provider_map:
                return {"total_limit": 0, "total_initial": 0, "ratio": 1.0}

            total_limit = sum(ctrl.limit for ctrl in provider_map.values())
            total_initial = sum(ctrl._initial for ctrl in provider_map.values())

            ratio = total_limit / total_initial if total_initial > 0 else 1.0
            return {
                "total_limit": total_limit,
                "total_initial": total_initial,
                "ratio": ratio,
            }

    def allocate_slots(self, total_slots: int) -> dict[str, int]:
        """Priority-based slot allocation across all registered controllers.

        Theory: Puterman (Markov Decision Processes, 1994) priority-based
        resource allocation. Under constrained resources, HIGH-priority states
        receive a guaranteed reservation, MEDIUM priorities share the remainder
        fairly, and LOW priorities receive only leftover idle capacity. This
        mirrors the MDP policy of preferring high-reward states under scarcity.

        Allocation rules:
          - HIGH: reserved_high = total_slots // 3 each, capped at controller.limit.
          - MEDIUM: fair-share of remaining slots after HIGH allocation.
          - LOW: only idle slots remaining after HIGH + MEDIUM.

        Args:
            total_slots: Total available concurrency slots to distribute.

        Returns:
            dict mapping controller name -> allocated slot count.
        """
        with self._lock:
            # Flatten all controllers across all providers
            all_ctrls = [
                ctrl
                for provider_map in self._controllers.values()
                for ctrl in provider_map.values()
            ]

            high = [c for c in all_ctrls if c._priority >= NodePriority.HIGH]
            medium = [c for c in all_ctrls if c._priority == NodePriority.MEDIUM]
            low = [c for c in all_ctrls if c._priority <= NodePriority.LOW]

            result: dict[str, int] = {}
            reserved_per_high = total_slots // 3

            # HIGH: each gets reserved_per_high, capped at their limit
            high_used = 0
            for ctrl in high:
                alloc = min(reserved_per_high, int(ctrl.limit))
                result[ctrl.name] = alloc
                high_used += alloc

            # MEDIUM: fair-share of remaining slots
            remaining_after_high = max(0, total_slots - high_used)
            if medium:
                fair_share = remaining_after_high // len(medium)
                medium_used = 0
                for ctrl in medium:
                    alloc = min(fair_share, int(ctrl.limit))
                    result[ctrl.name] = alloc
                    medium_used += alloc
            else:
                medium_used = 0

            # LOW: only idle slots remaining
            remaining_after_medium = max(0, remaining_after_high - medium_used)
            if low:
                low_share = remaining_after_medium // len(low)
                for ctrl in low:
                    alloc = min(low_share, int(ctrl.limit))
                    result[ctrl.name] = alloc
            else:
                for ctrl in low:
                    result[ctrl.name] = 0

            return result


# ---------------------------------------------------------------------------
# Module-level registry access
# ---------------------------------------------------------------------------

_registry: ControllerRegistry | None = None
_registry_lock = threading.Lock()


def _get_registry() -> ControllerRegistry:
    """Get or create the global ControllerRegistry. Thread-safe."""
    global _registry
    if _registry is None:
        with _registry_lock:
            if _registry is None:
                _registry = ControllerRegistry()
    return _registry


def get_controller(provider: str, node: str) -> ConcurrencyController:
    """Get a concurrency controller for the given provider and pipeline node.

    This is the primary API for Phase 27+. Each (provider, node) pair gets
    its own independent AIMD controller.

    Args:
        provider: LLM provider name (e.g., "openai", "anthropic")
        node: Pipeline node name (e.g., "extractor", "compiler", "profiler", "structural", "llm_checks")

    Returns:
        ConcurrencyController with the appropriate budget and priority.
    """
    return _get_registry().get(provider, node)


def reset_registry() -> None:
    """Reset the global registry. Used by tests to ensure clean state."""
    global _registry
    with _registry_lock:
        _registry = None
    # Also reset config singleton so env var changes take effect
    try:
        import src.config as config_mod

        config_mod._config = None
    except Exception:
        pass
---BREAK---
"""
Circuit breaker for LLM provider calls (GAP-1.2).

Tracks consecutive failures per provider and trips open after a threshold,
preventing cascading slow/failing calls. Auto-resets after a cooldown period.

Uses DynamoDB for global state across distributed Lambda workers.
"""

import enum
import logging
import math
import os
import time
from decimal import Decimal

try:
    import boto3
    from botocore.exceptions import ClientError
except ImportError:
    boto3 = None
    ClientError = Exception

logger = logging.getLogger(__name__)


class CircuitState(enum.Enum):
    CLOSED = "closed"
    OPEN = "open"
    HALF_OPEN = "half_open"


class CircuitBreaker:
    """Per-provider circuit breaker using DynamoDB for global state across workers."""

    def __init__(self, threshold: int = 5, cooldown: int = 120, table_name: str | None = None):
        self._threshold = threshold
        self._cooldown = cooldown
        from .config import get_config

        config = get_config()
        self.table_name = table_name or os.environ.get("RATE_LIMITS_TABLE", f"denuto-rate-limits-{config.environment}")
        self.table = None

        if boto3 and config.environment != "local" and not os.environ.get("DISABLE_DYNAMODB_CB"):
            try:
                dynamodb = boto3.resource("dynamodb", region_name=config.aws_region)
                self.table = dynamodb.Table(self.table_name)
            except Exception as e:
                logger.warning("Could not initialize DynamoDB for CircuitBreaker: %s", e)

        if not self.table:
            logger.info("Using fallback in-memory circuit breaker (DynamoDB disabled or not available)")
            self._local_state = {}

    def _get_db_state(self, provider: str) -> dict:
        if self.table is None:
            st = self._local_state.get(provider, {"failures": 0, "state": "closed", "opened_at": 0.0})
            if "state" not in st:
                st["state"] = "closed"
            return st

        try:
            response = self.table.get_item(Key={"PK": f"CB#{provider}", "SK": "STATE"})
            item = response.get("Item")
            if item:
                return {
                    "failures": int(item.get("failures", 0)),
                    "state": item.get("state", "closed"),
                    "opened_at": float(item.get("opened_at", 0.0)),
                }
        except ClientError as e:
            logger.warning("Error reading circuit breaker state from DynamoDB: %s", e)

        return {"failures": 0, "state": "closed", "opened_at": 0.0}

    def _put_db_state(self, provider: str, failures: int, state: str, opened_at: float):
        if self.table is None:
            self._local_state[provider] = {"failures": failures, "state": state, "opened_at": opened_at}
            return

        try:
            self.table.put_item(
                Item={
                    "PK": f"CB#{provider}",
                    "SK": "STATE",
                    "failures": failures,
                    "state": state,
                    "opened_at": Decimal(str(opened_at)),
                    "ttl": int(time.time()) + (86400 * 7),  # Auto cleanup after 7 days
                }
            )
        except ClientError as e:
            logger.warning("Error writing circuit breaker state to DynamoDB: %s", e)

    def record_success(self, provider: str) -> None:
        """Record a successful call — resets failure count and closes the circuit."""
        state = self._get_db_state(provider)
        if state["state"] != "closed":
            logger.info("Circuit breaker CLOSED for %s after successful probe", provider)
        self._put_db_state(provider, 0, "closed", 0.0)

    def record_failure(self, provider: str) -> None:
        """Record a failed call — increments count and may trip the circuit open."""
        if self.table is None:
            # In-memory fallback is single-process; read-modify-write is fine.
            state = self._get_db_state(provider)
            failures = state["failures"] + 1
            if state["state"] == "half_open":
                self._put_db_state(provider, failures, "open", time.time())
                logger.warning("Circuit breaker re-OPENED for %s (probe failed)", provider)
            elif failures >= self._threshold and state["state"] == "closed":
                self._put_db_state(provider, failures, "open", time.time())
                logger.warning("Circuit breaker OPEN for %s after %d consecutive failures", provider, failures)
            else:
                self._put_db_state(provider, failures, state["state"], state["opened_at"])
            return

        # Distributed path: the increment must be atomic. A get-then-put here
        # loses updates when two workers race (both read N, both write N+1), so
        # a burst of concurrent failures could keep the count below threshold
        # and the breaker would trip late or never.
        try:
            response = self.table.update_item(
                Key={"PK": f"CB#{provider}", "SK": "STATE"},
                UpdateExpression=(
                    "ADD failures :one "
                    "SET #st = if_not_exists(#st, :closed), "
                    "opened_at = if_not_exists(opened_at, :zero), "
                    "#ttl = :ttl"
                ),
                ExpressionAttributeNames={"#st": "state", "#ttl": "ttl"},
                ExpressionAttributeValues={
                    ":one": 1,
                    ":closed": "closed",
                    ":zero": Decimal("0"),
                    ":ttl": int(time.time()) + (86400 * 7),
                },
                ReturnValues="ALL_NEW",
            )
        except ClientError as e:
            logger.warning("Error recording circuit breaker failure to DynamoDB: %s", e)
            return

        item = response.get("Attributes", {})
        failures = int(item.get("failures", 1))
        current_state = item.get("state", "closed")

        if current_state == "half_open":
            # Probe failed — re-open
            self._put_db_state(provider, failures, "open", time.time())
            logger.warning("Circuit breaker re-OPENED for %s (probe failed)", provider)
        elif failures >= self._threshold and current_state == "closed":
            self._put_db_state(provider, failures, "open", time.time())
            logger.warning("Circuit breaker OPEN for %s after %d consecutive failures", provider, failures)

    def is_open(self, provider: str) -> bool:
        """Return True if the circuit is currently open (tripped) for *provider*."""
        state = self._get_db_state(provider)

        if state["state"] == "closed":
            return False

        if state["state"] == "open":
            # Check if cooldown has elapsed → transition to half-open
            if time.time() - state["opened_at"] >= self._cooldown:
                self._put_db_state(provider, state["failures"], "half_open", state["opened_at"])
                return False  # allow one probe
            return True

        # HALF_OPEN — not "open" (allow the probe)
        return False

    def allow_request(self, provider: str) -> bool:
        """Return True if a request to *provider* should be allowed."""
        return not self.is_open(provider)

    def get_state(self, provider: str) -> CircuitState:
        """Return the current circuit state for *provider* (for testing/observability)."""
        state_str = self._get_db_state(provider)["state"]
        return CircuitState(state_str)

    def get_failure_count(self, provider: str) -> int:
        """Return the current consecutive failure count for *provider*."""
        return self._get_db_state(provider)["failures"]

    def lyapunov_stable(self, failure_history: list[bool], window: int = 10) -> bool:
        """Lyapunov stability check on observed failure rates.

        Theory: Khalil (Nonlinear Systems, 3rd ed.) Lyapunov stability theorem.
        A system is stable at equilibrium if a Lyapunov function V(x) exists
        that is positive definite and whose derivative V̇(x) ≤ 0 (non-increasing).
        Here we treat the windowed failure rate as the Lyapunov candidate: the
        circuit is stable if failure rates are monotone non-increasing across
        successive windows (i.e., the system is recovering or at equilibrium).

        Args:
            failure_history: Ordered list of boolean outcomes (True = failure).
            window:          Number of observations per analysis chunk (default 10).

        Returns:
            True if failure rates are monotone non-increasing (stable) or if
            there are fewer than 2 complete windows (insufficient data → assume
            stable).
        """
        if len(failure_history) < window * 2:
            return True
        chunks = [
            failure_history[i : i + window]
            for i in range(0, len(failure_history) - window + 1, window)
        ]
        if len(chunks) < 2:
            return True
        rates = [sum(c) / len(c) for c in chunks]
        for prev_rate, curr_rate in zip(rates, rates[1:]):
            if curr_rate > prev_rate:
                return False
        return True

    def should_trip_early(self, failure_history: list[bool], alpha: float = 0.05) -> bool:
        """Sequential Probability Ratio Test for early circuit trip.

        Theory: Wald (Sequential Analysis, 1947) SPRT. Under H0 (normal
        operation) the failure rate is p0=0.1; under H1 (broken) it is
        p1=0.5. For each observation x the log-likelihood ratio is updated:
          LLR += log P(x | H1) - log P(x | H0)
        Trip if LLR > log((1-alpha)/alpha), i.e. the evidence strongly favours
        the broken hypothesis. Return False if evidence is insufficient.

        Args:
            failure_history: Ordered list of boolean outcomes (True = failure).
            alpha:           Type-I error bound (default 0.05 → trip threshold
                             log(0.95/0.05) ≈ 2.94).

        Returns:
            True if the SPRT has accumulated enough evidence to trip early.
        """
        p0 = 0.1  # H0: normal failure rate
        p1 = 0.5  # H1: broken failure rate
        trip_threshold = math.log((1.0 - alpha) / alpha)
        llr = 0.0
        for x in failure_history:
            p_h1 = p1 if x else (1.0 - p1)
            p_h0 = p0 if x else (1.0 - p0)
            llr += math.log(p_h1) - math.log(p_h0)
        return llr > trip_threshold


# Singleton
_circuit_breaker: CircuitBreaker | None = None


def get_circuit_breaker() -> CircuitBreaker:
    """Return the global CircuitBreaker singleton, creating it on first call."""
    global _circuit_breaker
    if _circuit_breaker is None:
        from .config import get_config

        config = get_config()
        _circuit_breaker = CircuitBreaker(
            threshold=config.circuit_breaker_threshold,
            cooldown=config.circuit_breaker_cooldown,
        )
    return _circuit_breaker


def reset_circuit_breaker() -> None:
    """Reset the singleton (for testing)."""
    global _circuit_breaker
    _circuit_breaker = None
