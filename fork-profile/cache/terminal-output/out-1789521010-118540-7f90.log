"""Tests for src.pipeline.symbolic.rules.

Owner doc: docs/design/bulk-review-neuro-symbolic-reasoning-plan.md §14.4.

Coverage:
  - cap_min_12_months: pass, fail, boundary (exact equality), missing inputs, bad values
  - notice_period_min_30_days: pass, fail, boundary, missing input
  - apply_rule: unknown rule_id, invalid rule_id characters, missing assertion key,
    unsupported operator, bad right-hand side
"""

from __future__ import annotations

from src.pipeline.symbolic.rules import apply_rule

# ===========================================================================
# cap_min_12_months
# ===========================================================================


class TestCapMin12Months:
    _RULE = "cap_min_12_months"

    def test_cap_exceeds_threshold(self):
        result = apply_rule(self._RULE, {"cap_value": 1_500_000, "annual_fees": 100_000})
        assert result["ok"] is True
        assert result["pass"] is True

    def test_cap_equals_threshold_exactly(self):
        # 1_200_000 == 12 * 100_000 → should pass (>=)
        result = apply_rule(self._RULE, {"cap_value": 1_200_000, "annual_fees": 100_000})
        assert result["ok"] is True
        assert result["pass"] is True

    def test_cap_below_threshold(self):
        result = apply_rule(self._RULE, {"cap_value": 1_199_999, "annual_fees": 100_000})
        assert result["ok"] is True
        assert result["pass"] is False

    def test_cap_far_below_threshold(self):
        result = apply_rule(self._RULE, {"cap_value": 0, "annual_fees": 500_000})
        assert result["ok"] is True
        assert result["pass"] is False

    def test_pass_reason_returned(self):
        result = apply_rule(self._RULE, {"cap_value": 2_000_000, "annual_fees": 100_000})
        assert result["ok"] is True
        assert result["pass"] is True
        assert isinstance(result["reason"], str)
        assert len(result["reason"]) > 0

    def test_fail_reason_returned(self):
        result = apply_rule(self._RULE, {"cap_value": 100, "annual_fees": 100_000})
        assert result["ok"] is True
        assert result["pass"] is False
        assert isinstance(result["reason"], str)

    def test_missing_cap_value(self):
        result = apply_rule(self._RULE, {"annual_fees": 100_000})
        assert result["ok"] is False
        assert "cap_value" in result["reason"]

    def test_missing_annual_fees(self):
        result = apply_rule(self._RULE, {"cap_value": 1_200_000})
        assert result["ok"] is False
        assert "annual_fees" in result["reason"]

    def test_missing_both_inputs(self):
        result = apply_rule(self._RULE, {})
        assert result["ok"] is False

    def test_float_inputs(self):
        result = apply_rule(self._RULE, {"cap_value": 1_200_000.0, "annual_fees": 100_000.0})
        assert result["ok"] is True
        assert result["pass"] is True

    def test_string_numeric_inputs_coerced(self):
        result = apply_rule(self._RULE, {"cap_value": "1200000", "annual_fees": "100000"})
        assert result["ok"] is True
        assert result["pass"] is True

    def test_zero_annual_fees(self):
        # If annual_fees == 0 the threshold is 0, so any cap >= 0 passes.
        result = apply_rule(self._RULE, {"cap_value": 0, "annual_fees": 0})
        assert result["ok"] is True
        assert result["pass"] is True

    def test_fractional_annual_fees(self):
        result = apply_rule(self._RULE, {"cap_value": 18_000, "annual_fees": 1_500})
        # threshold = 12 * 1500 = 18000 → exactly equal → pass
        assert result["ok"] is True
        assert result["pass"] is True


