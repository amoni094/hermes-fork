# parse_money — cross-currency comparison (must fail closed)
# ===========================================================================


class TestCrossCurrencyFailsClosed:
    def test_mixed_currencies_in_text(self):
        # parse_money returns the first match only; comparison is caller's job
        result = parse_money("USD 100,000 vs GBP 80,000")
        assert result["ok"] is True
        # First match is USD
        assert result["currency"] == "USD"

    def test_no_implicit_exchange_rate(self):
        # Verifies we don't silently convert between currencies
        r1 = parse_money("USD 1,000,000")
        r2 = parse_money("AUD 1,000,000")
        assert r1["ok"] and r2["ok"]
        # Same amount string, different currency — cannot compare without a rate
        assert r1["amount"] == r2["amount"]
        assert r1["currency"] != r2["currency"]


