"""Tests for src.pipeline.symbolic.duration.

Owner doc: docs/design/bulk-review-neuro-symbolic-reasoning-plan.md §14.1.

Coverage targets:
  - 50+ cases across parse_duration and convert_duration
  - Written-out numbers, parenthetical forms, business vs. calendar
  - Edge cases: Unicode, OCR artefacts, exotic spacing, malformed input
  - Round-trip: parse_duration result feeds convert_duration and back
"""

from __future__ import annotations

import datetime

import pytest

from src.pipeline.symbolic import duration as duration_module
from src.pipeline.symbolic.duration import convert_duration, parse_duration

# ===========================================================================
# Helpers
# ===========================================================================


def ok(value: float, unit: str) -> dict:
    return {"ok": True, "value": value, "unit": unit}


def _parse_ok(text: str, expected_value: float, expected_unit: str) -> None:
    result = parse_duration(text)
    assert result["ok"] is True, f"Expected ok for {text!r}, got {result}"
    assert result["value"] == expected_value, f"value mismatch for {text!r}: {result}"
    assert result["unit"] == expected_unit, f"unit mismatch for {text!r}: {result}"


def _parse_fail(text: str) -> None:
    result = parse_duration(text)
    assert result["ok"] is False, f"Expected failure for {text!r}, got {result}"


# ===========================================================================
# parse_duration — digit forms (happy path)
# ===========================================================================


class TestParseDurationDigits:
    def test_simple_days(self):
        _parse_ok("30 days", 30.0, "day")

    def test_singular_day(self):
        _parse_ok("1 day", 1.0, "day")

    def test_simple_months(self):
        _parse_ok("6 months", 6.0, "month")

    def test_singular_month(self):
        _parse_ok("1 month", 1.0, "month")

    def test_simple_years(self):
        _parse_ok("2 years", 2.0, "year")

    def test_singular_year(self):
        _parse_ok("1 year", 1.0, "year")

    def test_simple_weeks(self):
        _parse_ok("4 weeks", 4.0, "week")

    def test_singular_week(self):
        _parse_ok("1 week", 1.0, "week")

    def test_business_days_spelled_out(self):
        _parse_ok("30 business days", 30.0, "business_day")

    def test_business_day_singular(self):
        _parse_ok("1 business day", 1.0, "business_day")

    def test_working_days(self):
        _parse_ok("10 working days", 10.0, "business_day")

    def test_working_day_singular(self):
        _parse_ok("1 working day", 1.0, "business_day")

    def test_embedded_in_sentence(self):
        _parse_ok("Notice period is 30 days from the date of termination.", 30.0, "day")

    def test_leading_trailing_whitespace(self):
        _parse_ok("  14 days  ", 14.0, "day")

    def test_decimal_months(self):
        # Unlikely in legal text but should parse
        _parse_ok("1.5 months", 1.5, "month")


# ===========================================================================
# parse_duration — parenthetical forms
# ===========================================================================


class TestParseDurationParenthetical:
    def test_parenthetical_digit_wins(self):
        # "thirty (30) days" — parenthetical should win
        _parse_ok("thirty (30) days", 30.0, "day")

    def test_parenthetical_with_spaces(self):
        _parse_ok("two ( 2 ) months", 2.0, "month")

    def test_ninety_days_parenthetical(self):
        _parse_ok("ninety (90) days", 90.0, "day")

    def test_twelve_months_parenthetical(self):
        _parse_ok("twelve (12) months", 12.0, "month")

    def test_digit_then_parenthetical_digit(self):
        # "30 (thirty) days" — first digit group wins, paren not used here
        result = parse_duration("30 (thirty) days")
        assert result["ok"] is True
        assert result["value"] == 30.0

    def test_parenthetical_business_days(self):
        _parse_ok("ten (10) business days", 10.0, "business_day")


# ===========================================================================
# parse_duration — written-out cardinal numbers
# ===========================================================================


class TestParseDurationWrittenOut:
    def test_written_thirty(self):
        _parse_ok("thirty days", 30.0, "day")

    def test_written_sixty(self):
        _parse_ok("sixty days", 60.0, "day")

    def test_written_ninety(self):
        _parse_ok("ninety days", 90.0, "day")

    def test_written_two_months(self):
        _parse_ok("two months", 2.0, "month")

    def test_written_twelve_months(self):
        _parse_ok("twelve months", 12.0, "month")

    def test_written_compound_twenty_one(self):
        _parse_ok("twenty-one days", 21.0, "day")

    def test_written_compound_forty_five(self):
        _parse_ok("forty-five days", 45.0, "day")

    def test_written_one_year(self):
        _parse_ok("one year", 1.0, "year")

    def test_written_three_years(self):
        _parse_ok("three years", 3.0, "year")

    def test_written_five_business_days(self):
        _parse_ok("five business days", 5.0, "business_day")

    def test_case_insensitive_written(self):
        _parse_ok("THIRTY Days", 30.0, "day")

    def test_written_with_leading_article(self):
        # "a period of thirty days" should still parse
        _parse_ok("a period of thirty days", 30.0, "day")


# ===========================================================================
# parse_duration — edge cases and OCR artefacts
# ===========================================================================


class TestParseDurationEdgeCases:
    def test_unicode_non_breaking_space(self):
        # Non-breaking space between number and unit
        _parse_ok("30\u00a0days", 30.0, "day")

    @pytest.mark.parametrize("separator", ["\u2010", "\u2011", "\u2012", "\u2013", "\u2014", "\u2212"])
    def test_unicode_hyphen_variants_in_compound_word(self, separator: str):
        _parse_ok(f"twenty{separator}one days", 21.0, "day")

    def test_trailing_period(self):
        _parse_ok("30 days.", 30.0, "day")

    def test_comma_in_sentence(self):
        _parse_ok("The notice period shall be 30 days, starting from receipt.", 30.0, "day")

    def test_uppercase_unit(self):
        _parse_ok("30 Days", 30.0, "day")

    def test_all_caps_unit(self):
        _parse_ok("30 DAYS", 30.0, "day")

    def test_integer_with_comma_thousands(self):
        # Edge case: "1,000 days" — unusual but parseable
        result = parse_duration("1,000 days")
        # Should parse to 1000.0
        if result["ok"]:
            assert result["value"] == 1000.0

    def test_no_duration_returns_failure(self):
        _parse_fail("This agreement is between Party A and Party B.")

    def test_empty_string_returns_failure(self):
        _parse_fail("")

    def test_whitespace_only_returns_failure(self):
        _parse_fail("   ")

    def test_non_string_input(self):
        result = parse_duration(123)  # type: ignore[arg-type]
        assert result["ok"] is False

    def test_none_input(self):
        result = parse_duration(None)  # type: ignore[arg-type]
        assert result["ok"] is False

    def test_ocr_double_space(self):
        # OCR sometimes produces double spaces
        _parse_ok("30  days", 30.0, "day")

    def test_first_match_wins(self):
        # When multiple durations appear, first wins
        result = parse_duration("Within 30 days or 6 months, whichever comes first.")
        assert result["ok"] is True
        assert result["value"] == 30.0
        assert result["unit"] == "day"


# ===========================================================================
# convert_duration — happy path
# ===========================================================================


class TestConvertDurationHappyPath:
    def test_same_unit_returns_unchanged(self):
        d = parse_duration("30 days")
        result = convert_duration(d, "day")
        assert result["ok"] is True
        assert result["value"] == 30.0
        assert result["unit"] == "day"

    def test_same_unit_business_day(self):
        d = parse_duration("10 business days")
        result = convert_duration(d, "business_day")
        assert result["ok"] is True
        assert result["value"] == 10.0

    def test_days_to_weeks_approximate(self):
        d = parse_duration("14 days")
        result = convert_duration(d, "week")
        assert result["ok"] is True
        assert abs(result["value"] - 2.0) < 0.1

    def test_weeks_to_days(self):
        d = parse_duration("2 weeks")
        result = convert_duration(d, "day")
        assert result["ok"] is True
        assert result["value"] == pytest.approx(14.0, abs=0.01)

    def test_months_to_days_approximate(self):
        d = parse_duration("1 month")
        result = convert_duration(d, "day")
        assert result["ok"] is True
        assert 28 <= result["value"] <= 32

    def test_years_to_months_approximate(self):
        d = parse_duration("1 year")
        result = convert_duration(d, "month")
        assert result["ok"] is True
        assert abs(result["value"] - 12.0) < 0.5

    def test_days_to_business_days_exact(self):
        # 7 calendar days → approximately 5 business days (week)
        d = parse_duration("7 days")
        result = convert_duration(d, "business_day", jurisdiction="AU")
        assert result["ok"] is True
        # Should be around 5 business days but exact depends on current date
        assert 4 <= result["value"] <= 6

    def test_business_days_to_calendar_days_exact(self, monkeypatch):
        class FixedDate(datetime.date):
            @classmethod
            def today(cls):
                return cls(2026, 7, 6)

        monkeypatch.setattr(duration_module.datetime, "date", FixedDate)
        d = parse_duration("5 business days")
        result = convert_duration(d, "day", jurisdiction="AU")
        assert result["ok"] is True
        # 5 business days → 7 calendar days (Mon–Fri span)
        assert 5 <= result["value"] <= 9

    def test_accepts_unit_aliases_in_target(self):
        d = parse_duration("30 days")
        result = convert_duration(d, "months")
        assert result["ok"] is True

    def test_business_days_to_months(self):
        d = parse_duration("22 business days")
        result = convert_duration(d, "month")
        assert result["ok"] is True
        assert result["value"] > 0


# ===========================================================================
# convert_duration — error cases
# ===========================================================================


class TestConvertDurationErrors:
    def test_failed_parse_result_rejected(self):
        bad = {"ok": False, "reason": "no match"}
        result = convert_duration(bad, "day")
        assert result["ok"] is False

    def test_unknown_target_unit(self):
        d = parse_duration("30 days")
        result = convert_duration(d, "fortnight")
        assert result["ok"] is False

    def test_non_dict_input(self):
        result = convert_duration("30 days", "day")  # type: ignore[arg-type]
        assert result["ok"] is False

    def test_malformed_dict_missing_value(self):
        result = convert_duration({"ok": True, "unit": "day"}, "week")
        assert result["ok"] is False

    def test_malformed_dict_missing_unit(self):
        result = convert_duration({"ok": True, "value": 30.0}, "week")
        assert result["ok"] is False


# ===========================================================================
# Round-trip tests
# ===========================================================================


class TestRoundTrip:
    def test_days_roundtrip_via_weeks(self):
        text = "14 days"
        d = parse_duration(text)
        as_weeks = convert_duration(d, "week")
        back = convert_duration(as_weeks, "day")
        assert back["ok"] is True
        assert abs(back["value"] - 14.0) < 1.0  # allow floating-point slop

    def test_months_roundtrip_via_days(self):
        d = parse_duration("3 months")
        as_days = convert_duration(d, "day")
        back = convert_duration(as_days, "month")
        assert back["ok"] is True
        assert abs(back["value"] - 3.0) < 0.1

    def test_business_days_approximate_roundtrip(self):
        # Business-day ↔ calendar-day roundtrip is approximate
        d = parse_duration("10 business days")
        as_cal = convert_duration(d, "day")
        back = convert_duration(as_cal, "business_day")
        assert back["ok"] is True
        # Roundtrip should be within 20% due to calendar approximation
        assert abs(back["value"] - 10.0) / 10.0 < 0.20

    def test_year_to_months_to_year(self):
        d = parse_duration("2 years")
        as_months = convert_duration(d, "month")
        back = convert_duration(as_months, "year")
        assert back["ok"] is True
        assert abs(back["value"] - 2.0) < 0.1

