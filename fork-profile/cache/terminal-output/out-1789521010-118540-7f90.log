"""Tests for src.pipeline.symbolic.formula.

Owner doc: docs/design/bulk-review-neuro-symbolic-reasoning-plan.md §14.2.

Coverage targets:
  - Happy path: arithmetic, max/min, identifiers from env
  - Missing identifiers: {ok: False}
  - Malicious input rejection: __import__, os.system, etc.
  - Security: no arbitrary builtins, no attribute access, no subscripts
  - Edge cases: division by zero, empty expression, non-string input
"""

from __future__ import annotations

from decimal import Decimal

from src.pipeline.symbolic.formula import evaluate_money_formula

# ---------------------------------------------------------------------------
# Helpers
# ---------------------------------------------------------------------------


def _ok(expr: str, env: dict, expected: str) -> None:
    result = evaluate_money_formula(expr, env)
    assert result["ok"] is True, f"Expected ok for {expr!r}, got {result}"
    assert Decimal(result["value"]) == Decimal(expected), (
        f"value mismatch for {expr!r}: expected {expected}, got {result['value']}"
    )


def _fail(expr: str, env: dict | None = None) -> dict:
    result = evaluate_money_formula(expr, env or {})
    assert result["ok"] is False, f"Expected failure for {expr!r}, got {result}"
    return result


# ===========================================================================
# Happy path — arithmetic
# ===========================================================================


class TestArithmetic:
    def test_multiply_scalar(self):
        _ok("12 * monthly_fees", {"monthly_fees": Decimal("50000")}, "600000")

    def test_add_two_values(self):
        _ok("cap + buffer", {"cap": Decimal("1000000"), "buffer": Decimal("100000")}, "1100000")

    def test_subtract(self):
        _ok("total - deductible", {"total": Decimal("500000"), "deductible": Decimal("50000")}, "450000")

    def test_divide(self):
        _ok("annual / 12", {"annual": Decimal("1200000")}, "100000")

    def test_integer_literals(self):
        _ok("3 * 4", {}, "12")

    def test_decimal_literal(self):
        _ok("1.5 * base", {"base": Decimal("1000000")}, "1500000")

    def test_compound_expression(self):
        _ok(
            "12 * monthly_fees + buffer",
            {"monthly_fees": Decimal("50000"), "buffer": Decimal("25000")},
            "625000",
        )

    def test_nested_arithmetic(self):
        _ok(
            "(cap_a + cap_b) / 2",
            {"cap_a": Decimal("1000000"), "cap_b": Decimal("2000000")},
            "1500000",
        )

    def test_unary_negation(self):
        _ok("-offset + total", {"offset": Decimal("100000"), "total": Decimal("500000")}, "400000")

    def test_env_with_int_values(self):
        _ok("n * unit_fee", {"n": 12, "unit_fee": 5000}, "60000")

    def test_env_with_float_values(self):
        result = evaluate_money_formula("rate * principal", {"rate": 0.05, "principal": 1000000})
        assert result["ok"] is True
        assert abs(Decimal(result["value"]) - Decimal("50000")) < Decimal("0.01")


# ===========================================================================
# Happy path — max / min
# ===========================================================================


class TestMaxMin:
    def test_max_two_identifiers(self):
        _ok(
            "max(direct, indirect)",
            {"direct": Decimal("300000"), "indirect": Decimal("500000")},
            "500000",
        )

    def test_min_two_identifiers(self):
        _ok(
            "min(floor, cap)",
            {"floor": Decimal("100000"), "cap": Decimal("1000000")},
            "100000",
        )

    def test_max_with_literal(self):
        _ok("max(1000000, cap)", {"cap": Decimal("750000")}, "1000000")

    def test_min_with_expression(self):
        _ok(
            "min(12 * monthly, cap)",
            {"monthly": Decimal("50000"), "cap": Decimal("500000")},
            "500000",
        )

    def test_max_three_args(self):
        _ok(
            "max(a, b, c)",
            {"a": Decimal("100"), "b": Decimal("300"), "c": Decimal("200")},
            "300",
        )

    def test_nested_max_min(self):
        _ok(
            "max(min(a, b), c)",
            {"a": Decimal("500000"), "b": Decimal("300000"), "c": Decimal("400000")},
            "400000",
        )


