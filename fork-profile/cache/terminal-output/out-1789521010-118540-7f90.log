# Malicious input rejection
# ===========================================================================


class TestSecurityRejection:
    def test_import_rejected(self):
        r = _fail("__import__('os').system('rm -rf /')")
        assert r["ok"] is False

    def test_dunder_name_rejected(self):
        r = _fail("__builtins__['eval']('1+1')")
        assert r["ok"] is False

    def test_attribute_access_rejected(self):
        r = _fail("os.path.join('a', 'b')", {})
        assert r["ok"] is False

    def test_subscript_rejected(self):
        r = _fail("env['secret']", {"env": {}})
        assert r["ok"] is False

    def test_exec_rejected(self):
        r = _fail("exec('import os')")
        assert r["ok"] is False

    def test_lambda_rejected(self):
        r = _fail("(lambda x: x)(42)")
        assert r["ok"] is False

    def test_list_comprehension_rejected(self):
        r = _fail("[x for x in range(10)]")
        assert r["ok"] is False

    def test_unknown_function_rejected(self):
        r = _fail("open('/etc/passwd').read()")
        assert r["ok"] is False

    def test_print_rejected(self):
        r = _fail("print('hello')")
        assert r["ok"] is False

    def test_eval_rejected(self):
        r = _fail("eval('1+1')")
        assert r["ok"] is False

    def test_format_string_injection(self):
        # Attempting to use a format string with attribute access
        r = _fail("'{0.__class__}'.format(cap)", {"cap": Decimal("100")})
        assert r["ok"] is False


# ===========================================================================
# Edge cases
# ===========================================================================


class TestEdgeCases:
    def test_empty_expression(self):
        r = _fail("", {})
        assert "empty" in r["reason"]

    def test_whitespace_only(self):
        r = _fail("   ", {})
        assert r["ok"] is False

    def test_non_string_expr(self):
        result = evaluate_money_formula(12, {})  # type: ignore[arg-type]
        assert result["ok"] is False

    def test_non_dict_env(self):
        result = evaluate_money_formula("12 * x", [("x", 5)])  # type: ignore[arg-type]
        assert result["ok"] is False

    def test_syntax_error(self):
        r = _fail("12 * * monthly_fees", {"monthly_fees": Decimal("50000")})
        assert "syntax" in r["reason"].lower()

    def test_large_multiplication(self):
        _ok(
