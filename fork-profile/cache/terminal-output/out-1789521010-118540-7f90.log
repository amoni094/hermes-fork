"""Tests for src.pipeline.symbolic.compare.

Owner doc: docs/design/bulk-review-neuro-symbolic-reasoning-plan.md §14.3.

Coverage:
  - Numeric comparison (int, float, mixed int/float)
  - Duration comparison (same unit, cross-unit)
  - Money comparison (same currency, cross-currency rejection)
  - ISO date string comparison
  - Unsupported operators
  - Type-mismatch inputs
"""

from __future__ import annotations

from src.pipeline.symbolic.compare import compare
from src.pipeline.symbolic.duration import parse_duration

# ---------------------------------------------------------------------------
# Helpers
# ---------------------------------------------------------------------------


def _dur(text: str) -> dict:
    return parse_duration(text)


def _money(amount: float, currency: str) -> dict:
    return {"ok": True, "amount": amount, "currency": currency}


def ok_result(result: bool) -> dict:
    return {"ok": True, "result": result}


# ===========================================================================
# Numeric comparison
# ===========================================================================


class TestNumericCompare:
    def test_lt_true(self):
        assert compare(10, "<", 20) == ok_result(True)

    def test_lt_false(self):
        assert compare(20, "<", 10) == ok_result(False)

    def test_le_equal(self):
        assert compare(10, "<=", 10) == ok_result(True)

    def test_gt_true(self):
        assert compare(100, ">", 50) == ok_result(True)

    def test_ge_false(self):
        assert compare(5, ">=", 10) == ok_result(False)

    def test_eq_true(self):
        assert compare(42, "==", 42) == ok_result(True)

    def test_ne_true(self):
        assert compare(1, "!=", 2) == ok_result(True)

    def test_float_comparison(self):
        assert compare(1.5, "<", 2.5) == ok_result(True)

    def test_mixed_int_float(self):
        assert compare(1, "<=", 1.0) == ok_result(True)

    def test_zero_vs_positive(self):
        assert compare(0, "<", 0.1) == ok_result(True)


# ===========================================================================
# Duration comparison
# ===========================================================================


class TestDurationCompare:
    def test_same_unit_lt(self):
        a, b = _dur("30 days"), _dur("60 days")
        assert compare(a, "<", b) == ok_result(True)

    def test_same_unit_eq(self):
        a = _dur("30 days")
        assert compare(a, "==", _dur("30 days")) == ok_result(True)

    def test_cross_unit_days_vs_months(self):
        # 30 days < 2 months (≈61 days)
        a, b = _dur("30 days"), _dur("2 months")
        result = compare(a, "<", b)
        assert result["ok"] is True
        assert result["result"] is True

    def test_business_days_vs_calendar_days(self):
        # 10 business days ≈ 14 calendar days; both compared in calendar days
        a, b = _dur("10 business days"), _dur("14 days")
        result = compare(a, "<", b)
        assert result["ok"] is True

    def test_duration_gt(self):
        a, b = _dur("6 months"), _dur("30 days")
        assert compare(a, ">", b) == ok_result(True)

    def test_duration_ne(self):
        a, b = _dur("30 days"), _dur("60 days")
        assert compare(a, "!=", b) == ok_result(True)


# ===========================================================================
# Money comparison
# ===========================================================================


class TestMoneyCompare:
    def test_same_currency_lt(self):
        a = _money(500_000, "AUD")
        b = _money(1_000_000, "AUD")
        assert compare(a, "<", b) == ok_result(True)

    def test_same_currency_ge_true(self):
        a = _money(1_500_000, "AUD")
        b = _money(1_000_000, "AUD")
        assert compare(a, ">=", b) == ok_result(True)

    def test_same_currency_eq(self):
        a = b = _money(250_000, "USD")
        assert compare(a, "==", b) == ok_result(True)

    def test_cross_currency_fails_closed(self):
        a = _money(1_000_000, "AUD")
        b = _money(1_000_000, "USD")
        result = compare(a, "<", b)
        assert result["ok"] is False
        assert "currencies" in result["reason"].lower() or "currency" in result["reason"].lower()

    def test_cross_currency_aud_vs_gbp(self):
        result = compare(_money(100, "AUD"), "==", _money(100, "GBP"))
        assert result["ok"] is False


# ===========================================================================
# ISO date string comparison
# ===========================================================================


class TestDateCompare:
    def test_date_lt(self):
        assert compare("2024-01-01", "<", "2025-01-01") == ok_result(True)

    def test_date_gt(self):
        assert compare("2026-06-01", ">", "2025-12-31") == ok_result(True)

    def test_date_eq(self):
        assert compare("2024-03-15", "==", "2024-03-15") == ok_result(True)

    def test_date_ne(self):
        assert compare("2024-01-01", "!=", "2024-12-31") == ok_result(True)

    def test_date_le_equal(self):
        assert compare("2024-06-01", "<=", "2024-06-01") == ok_result(True)


# ===========================================================================
# Operator errors
# ===========================================================================


class TestOperatorErrors:
    def test_unsupported_operator(self):
        result = compare(1, "~=", 1)
        assert result["ok"] is False
        assert "unsupported" in result["reason"].lower()

    def test_empty_operator(self):
        result = compare(1, "", 1)
        assert result["ok"] is False

    def test_sql_like_operator_rejected(self):
        result = compare("foo", "LIKE", "foo%")
        assert result["ok"] is False


# ===========================================================================
# Type-mismatch inputs
# ===========================================================================


class TestTypeMismatch:
    def test_int_vs_duration(self):
        result = compare(30, "<", _dur("30 days"))
        assert result["ok"] is False

    def test_money_vs_duration(self):
        result = compare(_money(1000, "AUD"), ">", _dur("30 days"))
        assert result["ok"] is False

    def test_date_string_vs_int(self):
        result = compare("2024-01-01", "<", 2024)
        # Non-ISO string path — mixed types
        assert result["ok"] is False or (result["ok"] is True)  # implementation-defined; must not raise

    def test_none_input(self):
        result = compare(None, "==", None)
        # Should either succeed or fail gracefully
        assert "ok" in result

    def test_list_input(self):
        result = compare([1, 2], "<", [3, 4])
        assert "ok" in result  # must not raise
