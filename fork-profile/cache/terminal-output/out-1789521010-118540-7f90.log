"""Tests for src.pipeline.symbolic.verify.

Owner doc: docs/design/bulk-review-neuro-symbolic-reasoning-plan.md §14.3.

Coverage:
  - Exact, normalised, number-normalised, and fuzzy verification levels
  - OCR artefacts (double spaces, ligatures, character substitutions)
  - Currency formatting (AUD 1,500,000 ↔ digits)
  - Duration paraphrasing (thirty days ↔ 30 days)
  - Edge cases: empty inputs, non-string inputs, Unicode
"""

from __future__ import annotations

from src.pipeline.symbolic.verify import FUZZY_THRESHOLD, verify_span

# ---------------------------------------------------------------------------
# Helpers
# ---------------------------------------------------------------------------


def assert_verified(claim: str, span: str, reason_prefix: str | None = None) -> None:
    result = verify_span(claim, span)
    assert result["ok"] is True, f"Expected ok for {claim!r} in {span!r}: {result}"
    assert result["verified"] is True, f"Expected verified for {claim!r} in {span!r}: {result}"
    if reason_prefix:
        assert result["reason"].startswith(reason_prefix), (
            f"Expected reason starting with {reason_prefix!r}, got {result['reason']!r}"
        )


def assert_not_verified(claim: str, span: str) -> None:
    result = verify_span(claim, span)
    assert result["ok"] is True, f"Expected ok=True for {claim!r} in {span!r}: {result}"
    assert result["verified"] is False, f"Expected not verified for {claim!r} in {span!r}: {result}"


def assert_error(claim, span) -> None:
    result = verify_span(claim, span)
    assert result["ok"] is False, f"Expected ok=False for claim={claim!r}: {result}"


# ===========================================================================
# Level 1 — Exact containment
# ===========================================================================


class TestExactMatch:
    def test_simple_value_present(self):
        assert_verified("30 days", "The notice period is 30 days from termination.", "exact")

    def test_exact_currency_amount(self):
        assert_verified("AUD 1,500,000", "...capped at AUD 1,500,000 per year...", "exact")

    def test_exact_percentage(self):
        assert_verified("10%", "The rate shall be 10% per annum.", "exact")

    def test_exact_governing_law(self):
        assert_verified("New South Wales", "Governing law: New South Wales, Australia.", "exact")

    def test_exact_party_name(self):
        assert_verified("ACME Pty Ltd", "Customer means ACME Pty Ltd (ABN 12 345 678).", "exact")

    def test_claim_at_start_of_span(self):
        assert_verified("30 days", "30 days' notice shall be given.", "exact")

    def test_claim_at_end_of_span(self):
        assert_verified("30 days", "Notice must be at least 30 days", "exact")


# ===========================================================================
# Level 2 — Normalised containment (casefold, whitespace, punctuation)
# ===========================================================================


class TestNormalisedMatch:
    def test_case_difference(self):
        # "30 Days" normalises to match "30 days"
        assert_verified("30 Days", "The notice period is 30 days.", "normalised")

    def test_all_caps_claim(self):
        assert_verified("NEW SOUTH WALES", "Governing law: New South Wales.", "normalised")

    def test_punctuation_in_claim(self):
        # Trailing period in claim stripped by normalisation
        assert_verified("30 days.", "The period is 30 days from notice.", "normalised")

    def test_extra_whitespace_in_span(self):
        assert_verified("30 days", "The period is  30  days  from notice.", "normalised")

    def test_thin_space_normalised(self):
        # U+2009 thin space between value and unit (common in styled PDFs)
        span = "notice period: 30\u2009days"
        assert_verified("30 days", span)


# ===========================================================================
# Level 3 — Number normalisation (written numbers ↔ digits, thousands seps)
# ===========================================================================


class TestNumberNormalisedMatch:
    def test_written_thirty_vs_30(self):
        # claim extracted as canonical "30 days", span has written form
        assert_verified("30 days", "...give thirty days' written notice...", "number-normalised")

    def test_written_ninety_vs_90(self):
        assert_verified("90 days", "...ninety days after the Effective Date...", "number-normalised")

    def test_written_twelve_months(self):
        assert_verified("12 months", "...for a period of twelve months...", "number-normalised")

    def test_currency_thousands_separator(self):
        # Thousands separators are removed during base normalisation, so "1500000"
        # appears as a substring of the normalised span — verified at Level 2.
        assert_verified("1500000", "...the sum of AUD 1,500,000 in total...")

    def test_currency_code_stripped(self):
        assert_verified("1500000", "...limited to AUD1,500,000...")

    def test_written_compound_twenty_one(self):
        assert_verified("21 days", "...twenty-one days from delivery...", "number-normalised")


# ===========================================================================
# Level 4 — Fuzzy matching (OCR artefacts)
# ===========================================================================


class TestFuzzyMatch:
    def test_ocr_missing_space_between_tokens(self):
        # PDF column-scanning OCR sometimes merges tokens: "30days" instead of "30 days"
        assert_verified("30 days", "give 30days notice to the counterparty")

    def test_ocr_double_spaces_around_value(self):
        # OCR sometimes scatters extra whitespace between tokens (caught by Level 2)
        assert_verified("30 days", "give  30  days  written  notice")

    def test_high_overlap_slightly_different_phrasing(self):
        result = verify_span("notice period of 30 days", "...shall give at least 30 days notice...")
        # Should be verified at some level given high token overlap
        assert result["ok"] is True

    def test_fuzzy_threshold_documented(self):
        assert FUZZY_THRESHOLD == 0.80


# ===========================================================================
# Not-verified cases
# ===========================================================================


class TestNotVerified:
    def test_completely_different_span(self):
        assert_not_verified(
            "30 days",
            "This agreement sets out the terms for software licensing.",
        )

    def test_different_value_same_unit(self):
        assert_not_verified("60 days", "The notice period is 30 days from termination.")

    def test_partial_word_not_sufficient(self):
        assert_not_verified("termination", "The term of this agreement is fixed.")

    def test_empty_span(self):
        result = verify_span("30 days", "")
        assert result["ok"] is True
        assert result["verified"] is False

    def test_empty_span_whitespace_only(self):
        result = verify_span("30 days", "   ")
        assert result["ok"] is True
        assert result["verified"] is False


# ===========================================================================
# Input error cases
# ===========================================================================


class TestInputErrors:
    def test_non_string_claim(self):
        assert_error(30, "The notice period is 30 days.")

    def test_none_claim(self):
        assert_error(None, "The notice period is 30 days.")

    def test_non_string_span(self):
        assert_error("30 days", 12345)

    def test_none_span(self):
        assert_error("30 days", None)

    def test_empty_claim(self):
        result = verify_span("", "The notice period is 30 days.")
        assert result["ok"] is False

    def test_whitespace_only_claim(self):
        result = verify_span("   ", "The notice period is 30 days.")
        assert result["ok"] is False


# ===========================================================================
# Unicode and OCR edge cases
# ===========================================================================


class TestUnicodeEdgeCases:
    def test_non_breaking_space_in_span(self):
        # U+00A0 between number and unit
        span = "The notice period is 30\u00a0days from termination."
        assert_verified("30 days", span)

    def test_unicode_minus_in_compound(self):
        # U+2212 MINUS SIGN in "twenty-one" instead of ASCII hyphen-minus
        span = "give twenty\u2212one days notice"
        result = verify_span("21 days", span)
        assert result["ok"] is True

    def test_left_right_double_quotes_in_span(self):
        span = "“Notice Period” means 30 days."
        assert_verified("30 days", span)

    def test_fullwidth_digits(self):
        # U+FF13 U+FF10: fullwidth "30" — NFKC normalises to ASCII digits
        span = "notice period of \uff13\uff10 days"
        result = verify_span("30 days", span)
        assert result["ok"] is True

    def test_ocr_ligature_fi(self):
        # OCR ligature U+FB01 in "termination"
        span = "upon termiﬁcation, 30 days notice applies"
        assert_verified("30 days", span)

