"""Tests for src.pipeline.symbolic.aggregate.

Owner doc: docs/design/bulk-review-neuro-symbolic-reasoning-plan.md §14.3.

Coverage:
  - All five operators: sum, min, max, count, distinct
  - None handling (None entries skipped in numeric ops; counted in count)
  - Empty list and all-None list
  - Mixed-type rejection for sum/min/max
  - Non-list input rejection
  - Unsupported operator rejection
"""

from __future__ import annotations

import pytest

from src.pipeline.symbolic.aggregate import aggregate

# ===========================================================================
# count
# ===========================================================================


class TestCount:
    def test_count_all_present(self):
        assert aggregate([1, 2, 3], "count") == {"ok": True, "value": 3}

    def test_count_with_nones(self):
        assert aggregate([1, None, 3, None], "count") == {"ok": True, "value": 2}

    def test_count_all_none(self):
        assert aggregate([None, None], "count") == {"ok": True, "value": 0}

    def test_count_empty(self):
        assert aggregate([], "count") == {"ok": True, "value": 0}

    def test_count_strings(self):
        # count works on any type
        assert aggregate(["a", "b", None], "count") == {"ok": True, "value": 2}

    def test_count_mixed_types(self):
        assert aggregate([1, "two", 3.0, None], "count") == {"ok": True, "value": 3}


# ===========================================================================
# distinct
# ===========================================================================


class TestDistinct:
    def test_distinct_all_different(self):
        assert aggregate([1, 2, 3], "distinct") == {"ok": True, "value": 3}

    def test_distinct_with_duplicates(self):
        assert aggregate([1, 1, 2, 2, 3], "distinct") == {"ok": True, "value": 3}

    def test_distinct_all_same(self):
        assert aggregate([5, 5, 5], "distinct") == {"ok": True, "value": 1}

    def test_distinct_with_nones(self):
        assert aggregate([1, None, 1, None], "distinct") == {"ok": True, "value": 1}

    def test_distinct_empty(self):
        assert aggregate([], "distinct") == {"ok": True, "value": 0}

    def test_distinct_strings(self):
        assert aggregate(["a", "b", "a", "c"], "distinct") == {"ok": True, "value": 3}

    def test_distinct_unhashable_coerced(self):
        # Lists are unhashable; coerced to str representation for dedup
        result = aggregate([[1, 2], [1, 2], [3, 4]], "distinct")
        assert result["ok"] is True
        assert result["value"] == 2


# ===========================================================================
# sum
# ===========================================================================


class TestSum:
    def test_sum_integers(self):
        assert aggregate([1, 2, 3, 4], "sum") == {"ok": True, "value": 10}

    def test_sum_floats(self):
        result = aggregate([1.5, 2.5, 3.0], "sum")
        assert result["ok"] is True
        assert result["value"] == pytest.approx(7.0)

    def test_sum_with_nones_skipped(self):
        assert aggregate([1, None, 2, None, 3], "sum") == {"ok": True, "value": 6}

    def test_sum_single_value(self):
        assert aggregate([42], "sum") == {"ok": True, "value": 42}

    def test_sum_all_nones_error(self):
        result = aggregate([None, None], "sum")
        assert result["ok"] is False

    def test_sum_empty_error(self):
        result = aggregate([], "sum")
        assert result["ok"] is False

    def test_sum_mixed_int_float(self):
        result = aggregate([1, 2.5, 3], "sum")
        assert result["ok"] is True
        assert result["value"] == pytest.approx(6.5)


# ===========================================================================
# min
# ===========================================================================


class TestMin:
    def test_min_integers(self):
        assert aggregate([5, 3, 8, 1], "min") == {"ok": True, "value": 1}

    def test_min_floats(self):
        result = aggregate([2.5, 0.1, 3.7], "min")
        assert result["ok"] is True
        assert result["value"] == pytest.approx(0.1)

    def test_min_with_nones(self):
        assert aggregate([10, None, 5, None, 20], "min") == {"ok": True, "value": 5}

    def test_min_single_value(self):
        assert aggregate([7], "min") == {"ok": True, "value": 7}

    def test_min_empty_error(self):
        result = aggregate([], "min")
        assert result["ok"] is False


# ===========================================================================
# max
# ===========================================================================


class TestMax:
    def test_max_integers(self):
        assert aggregate([5, 3, 8, 1], "max") == {"ok": True, "value": 8}

    def test_max_floats(self):
        result = aggregate([2.5, 0.1, 3.7], "max")
        assert result["ok"] is True
        assert result["value"] == pytest.approx(3.7)

    def test_max_with_nones(self):
        assert aggregate([10, None, 5, None, 20], "max") == {"ok": True, "value": 20}

    def test_max_negative_values(self):
        assert aggregate([-1, -5, -2], "max") == {"ok": True, "value": -1}


# ===========================================================================
# Mixed-type rejection for sum/min/max
# ===========================================================================


class TestMixedTypeRejection:
    def test_sum_rejects_strings(self):
        result = aggregate([1, "two", 3], "sum")
        assert result["ok"] is False
        assert "numeric" in result["reason"].lower()

    def test_min_rejects_dict(self):
        result = aggregate([1, {"value": 2}, 3], "min")
        assert result["ok"] is False

    def test_max_rejects_bool(self):
        # bool is a subclass of int, but aggregate should reject it
        result = aggregate([1, True, 2], "max")
        assert result["ok"] is False

    def test_sum_rejects_none_only(self):
        result = aggregate([None], "sum")
        assert result["ok"] is False


# ===========================================================================
# Input / operator errors
# ===========================================================================


class TestInputErrors:
    def test_non_list_input(self):
        result = aggregate("not a list", "sum")
        assert result["ok"] is False

    def test_tuple_input_rejected(self):
        result = aggregate((1, 2, 3), "sum")
        assert result["ok"] is False

    def test_none_input(self):
        result = aggregate(None, "sum")
        assert result["ok"] is False

    def test_unsupported_op(self):
        result = aggregate([1, 2, 3], "product")
        assert result["ok"] is False
        assert "unsupported" in result["reason"].lower()

    def test_empty_string_op(self):
        result = aggregate([1, 2], "")
        assert result["ok"] is False
