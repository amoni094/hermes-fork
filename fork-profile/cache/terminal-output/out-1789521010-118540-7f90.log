        assert "zero" in r["reason"].lower() or "arithmetic" in r["reason"].lower()

    def test_identifier_zero(self):
        r = _fail("cap / zero_val", {"cap": Decimal("1000000"), "zero_val": Decimal("0")})
        assert r["ok"] is False


